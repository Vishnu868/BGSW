# Copy to .env and fill in what you have. Never commit .env.
# auto = first provider with a key, in this order: claude > gemini > groq ; none = rule-based only
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# server-side refusal fallback to another Claude model (on/off)
CLAUDE_FALLBACKS=on

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# name recorded in approvals and the audit trail
OPERATOR=vishnu
