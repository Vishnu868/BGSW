# Copy to .env and fill in what you have. Never commit .env.
# auto = first that is usable, in this order: claude (key) > gemini (key) > ollama (local server running)
# groq is only used when chosen explicitly (LLM_PROVIDER=groq); none = rule-based only
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# server-side refusal fallback to another Claude model (on/off)
CLAUDE_FALLBACKS=on

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# local model, no key, no rate limit, nothing leaves this computer (https://ollama.com):
#   ollama pull qwen3:4b      (fits a 4 GB laptop GPU; use qwen3:8b or qwen2.5:7b with more VRAM)
OLLAMA_MODEL=qwen3:4b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=300

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# name recorded in approvals and the audit trail
OPERATOR=vishnu

# identical AI questions are answered from .cache/llm (repeatable, free demo reruns): on / off
LLM_CACHE=on
# give one agent a different provider/model (e.g. an independent critic):
# CRITIC_PROVIDER=gemini
# CRITIC_MODEL=gemini-3.5-flash
